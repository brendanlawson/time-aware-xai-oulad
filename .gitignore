# ---- Data (never commit raw or intermediate datasets) ----
data/raw/
data/interim/
data/checkpoints/
*.parquet
*.pkl
!data/.gitkeep
# Train/test split: keep the canonical id list (committed); the materialised
# train/test parquets are regenerable and stay ignored via the *.parquet rule.
!data/splits/test_student_ids.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---- Testing & coverage ----
.pytest_cache/
.coverage
htmlcov/

# ---- Tooling caches ----
.mypy_cache/
.ruff_cache/

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- Secrets ----
.env
*.local

# --- task ----
task/

# clickhouse-local binary (182MB tool, do not version)
/clickhouse
# MS Office lock temp files
~$*
